# Copy to .env.local for development. On Railway, set these as service variables.

# --- Required ---------------------------------------------------------------
# Railway injects this automatically when you attach a Postgres service.
# Locally, point at a local Postgres or Railway's public proxy URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mulch2you

# Any high-entropy string of 32+ bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value in production to the one you use locally.
AUTH_SECRET=

# --- Email (magic links + drop notifications) --------------------------------
# Postmark → your Server → API Tokens. This is the SERVER token, not the
# account token. Without it, dev prints the sign-in link to the console and
# production refuses to start a sign-in.
POSTMARK_SERVER_TOKEN=
# Must be a CONFIRMED sender signature in Postmark, or every send 400s.
EMAIL_FROM="Mulch2You <hello@yourdomain.com.au>"
# Transactional stream. Only change if you created a custom message stream.
POSTMARK_MESSAGE_STREAM=outbound

# --- Maps --------------------------------------------------------------------
# MapTiler renders the map tiles (the high-volume, cost-sensitive part).
MAPTILER_KEY=
# Google Places Autocomplete resolves AU addresses — one call per listing, so
# cost is negligible. Restrict the key to your domain in Google Cloud Console.
GOOGLE_MAPS_KEY=

# --- SMS (Phase 2) -----------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Photo storage -----------------------------------------------------------
# MUST point at a Railway volume mount in production. Container filesystems are
# ephemeral, so without a volume every deploy deletes every uploaded photo.
# Railway: service → Settings → Volumes → mount at /data, then set this to /data.
UPLOAD_DIR=./.uploads

# --- Cron --------------------------------------------------------------------
# Shared secret the Railway cron service sends to the maintenance endpoints.
CRON_SECRET=

# --- Deployment --------------------------------------------------------------
# SET THIS IN PRODUCTION. Auth.js otherwise builds magic-link and redirect URLs
# from request headers, and behind Railway's proxy that can resolve to the
# container's own address (https://localhost:8080) instead of your domain.
# No trailing slash, and it must match the public origin exactly.
# AUTH_URL=https://mulch2you-production.up.railway.app
